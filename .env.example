# ==============================================================================
# DOOMSDAY PROTOCOL — KRATOS'26 RUNTIME ENVIRONMENT CONFIGURATION
# Cloudflare Pages & Cloudflare R2 Media Settings
#
# NOTE: Do NOT store private API keys or cloud credentials in this file.
# This frontend is static and only uses public delivery URLs.
# ==============================================================================

# 1. Cloudflare R2 Media Base URL (Public custom domain or r2.dev domain)
# Example: https://media.kratos26.net/doomsday-protocol
VITE_R2_MEDIA_URL=https://media.kratos26.net/doomsday-protocol

# 2. Cinematic Intro Video URL (~500MB MP4 hosted on Cloudflare R2)
# Example: https://media.kratos26.net/doomsday-protocol/videos/doomsday-protocol-intro.mp4
VITE_INTRO_VIDEO_URL=https://media.kratos26.net/doomsday-protocol/videos/doomsday-protocol-intro.mp4

# 3. Comic Art Source Toggle: Set to 'true' to load comic scenes from R2 instead of local SVG
# Defaults to 'false' (uses bundled deterministic SVGs)
VITE_USE_R2_MEDIA=false

# 4. Optional Live Event Arena Links (Populated during symposium competition hours)
VITE_ROUND1_KAHOOT_URL=
VITE_ROUND2_HACKERRANK_URL=
VITE_ROUND3_SUBMISSION_URL=
